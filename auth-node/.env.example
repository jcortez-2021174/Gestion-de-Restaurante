PORT=3020

URI_MONGODB=mongodb://127.0.0.1:27017/AureaRestaurant

JWT_SECRET=replace_with_the_authservice_jwt_secret
JWT_ISSUER=AuthService.Api
JWT_AUDIENCE=GestorRestaurante.Clients
JWT_EXPIRES_IN=1h

IDENTITY_PROVISIONING_KEY=replace_with_a_private_service_key

NODE_TLS_REJECT_UNAUTHORIZED=0

FRONTEND_URL=http://localhost:5173

SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your_smtp_account@gmail.com
SMTP_PASS=replace_with_an_app_password

SMTP_FROM_EMAIL=your_smtp_account@gmail.com
SMTP_FROM_NAME=Aurea Restaurant

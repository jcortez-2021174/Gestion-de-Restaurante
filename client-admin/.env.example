
# URLs base de los servicios
VITE_AUTH_API_URL=http://localhost:5022/api/v1
VITE_RESTAURANT_API_URL=http://localhost:3020/AureaRestaurant/Admin/v1

# Timeout de requests en milisegundos
VITE_REQUEST_TIMEOUT=10000

# Logging de requests HTTP (true en desarrollo, false en producción)
VITE_LOG_REQUESTS=false

# Información de la aplicación
VITE_APP_NAME=Aurea Restaurant
VITE_APP_VERSION=1.0.0

# Entorno (development, staging, production)
VITE_ENV=development

# Enable source maps en desarrollo
VITE_SOURCEMAP=true
